# Public browser credential from Pledge Impact Hub > Pledge APIs > Widgets.
# This value is intentionally exposed in the built frontend.
VITE_PLEDGE_PARTNER_KEY=

# Optional. Use sandbox only with a sandbox partner key and staging Pledge account.
VITE_PLEDGE_ENV=production

# Do not put the secret Pledge API key in this file.
# Configure it separately with: npx wrangler secret put PLEDGE_API_KEY
