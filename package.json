{
  "name": "donate-by-mail",
  "private": true,
  "version": "0.1.0",
  "overrides": {
    "undici": "7.29.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:db": "node scripts/run-supabase-command.mjs test db --local",
    "test:integration": "node scripts/run-integration-e2e.mjs",
    "contract:check": "node scripts/check-contract-version.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run test && vite build",
    "verify:app": "npm run typecheck && npm run build && npm run seo:check",
    "verify:release": "node scripts/verify-release.mjs",
    "seo:check": "node scripts/check-seo.mjs",
    "verify": "npm run security:secrets && npm run audit:all && npm run contract:check && npm run typecheck && npm run db:reset && npm run db:lint && npm run db:advisors && npm run test:db && npm run build && wrangler deploy --env beta --dry-run --strict",
    "preview": "vite preview",
    "db:start": "node scripts/run-supabase-command.mjs start",
    "db:stop": "node scripts/run-supabase-command.mjs stop",
    "db:reset": "node scripts/run-supabase-command.mjs db reset --local && node scripts/wait-for-local-db.mjs",
    "db:lint": "node scripts/run-supabase-command.mjs db lint --local --schema app_private,api --level warning --fail-on warning",
    "db:advisors": "node scripts/run-supabase-command.mjs db advisors --local --type all --level warn --fail-on warn",
    "db:types": "node scripts/generate-database-types.mjs",
    "security:secrets": "node scripts/check-no-secrets.mjs",
    "security:gitleaks-regression": "node scripts/gitleaks-regression.mjs",
    "audit:all": "npm audit --audit-level=high",
    "smoke:beta": "node scripts/beta-smoke.mjs",
    "smoke:agent": "node scripts/agent-smoke.mjs",
    "smoke:production": "node scripts/production-smoke.mjs",
    "check:beta-config": "node scripts/check-beta-config.mjs",
    "check:production-config": "node scripts/check-production-config.mjs",
    "check:production-auth": "node scripts/check-production-auth-config.mjs",
    "check:production-edge": "node scripts/check-production-edge.mjs",
    "check:production-dns": "node scripts/check-production-dns.mjs",
    "deploy": "node scripts/refuse-implicit-deploy.mjs",
    "deploy:beta": "VITE_PLEDGE_ENV=sandbox npm run check:beta-config && VITE_PLEDGE_ENV=sandbox npm run verify:app && wrangler deploy --env beta --strict && npm run smoke:beta",
    "deploy:beta:dry-run": "VITE_PLEDGE_ENV=sandbox npm run check:beta-config && VITE_PLEDGE_ENV=sandbox npm run verify:app && wrangler deploy --env beta --dry-run --strict",
    "deploy:production": "node scripts/deploy-production.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.111.0",
    "lucide-react": "^0.469.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@cloudflare/workers-types": "5.20260807.2",
    "@playwright/test": "1.62.1",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "postcss": "8.5.26",
    "supabase": "2.112.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.4",
    "wrangler": "4.120.0"
  }
}
