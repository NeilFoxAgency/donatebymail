{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "donate-by-mail",
  "compatibility_date": "2026-07-21",
  "main": "src/worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "send_email": [
    {
      "name": "ADMIN_EMAIL",
      "destination_address": "satoshi@donatebymail.org"
    }
  ],
  "vars": {
    "ADMIN_NOTIFICATION_FROM": "notifications@donatebymail.org",
    "ADMIN_NOTIFICATION_TO": "satoshi@donatebymail.org"
  }
}
