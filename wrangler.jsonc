{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "donate-by-mail",
  "compatibility_date": "2026-08-07",
  "main": "src/agentWorker.ts",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "donatebymail.org",
      "custom_domain": true,
    },
    {
      "pattern": "www.donatebymail.org",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "secrets": {
    "required": ["BREVO_API_KEY"],
  },
  "vars": {
    "DEPLOYMENT_ENVIRONMENT": "production",
    "BREVO_SENDER_EMAIL": "contact@donatebymail.org",
    "BREVO_SENDER_NAME": "Donate by Mail",
    "ADMIN_NOTIFICATION_TO": "tre@donatebymail.org",
    "REPLY_TO_EMAIL": "tre@donatebymail.org",
  },
  "env": {
    "beta": {
      "workers_dev": false,
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": true,
      },
      "routes": [
        {
          "pattern": "beta.donatebymail.org",
          "custom_domain": true,
        },
        {
          "pattern": "mcp-beta.donatebymail.org",
          "custom_domain": true,
        },
        {
          "pattern": "mcp-connector-beta.donatebymail.org",
          "custom_domain": true,
        },
        {
          "pattern": "mcp-oauth-beta.donatebymail.org",
          "custom_domain": true,
        },
      ],
      "secrets": {
        "required": [
          "BREVO_API_KEY",
          "PLEDGE_API_KEY",
          "SUPABASE_URL",
          "SUPABASE_PUBLISHABLE_KEY",
          "SUPABASE_SECRET_KEY",
          "DONATION_TRACKING_SECRET",
          "BFF_SESSION_SECRET",
          "AGENT_API_KEY",
          "MCP_ARTICLE_BEARER_TOKEN",
        ],
      },
      "triggers": {
        "crons": ["*/5 * * * *"],
      },
      "vars": {
        "DEPLOYMENT_ENVIRONMENT": "beta",
        "CF_ACCESS_TEAM_DOMAIN": "nameless-resonance-00ea.cloudflareaccess.com",
        "CF_ACCESS_AUDIENCE": "24a4b765443b92f55680c9983cfdec85bf3dc9b03e572671141053dcfba9b959",
        "BREVO_SENDER_EMAIL": "contact@donatebymail.org",
        "BREVO_SENDER_NAME": "Donate by Mail Beta",
        "ADMIN_NOTIFICATION_TO": "tre@donatebymail.org",
        "REPLY_TO_EMAIL": "tre@donatebymail.org",
      },
    },
  },
}
